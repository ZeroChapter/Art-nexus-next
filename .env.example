# Public site URL (SEO, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://art-nexus.ru

# Public API URL (used in browser for client-side fetches)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Internal API URL for server-side fetches (Docker / SSR)
API_INTERNAL_URL=http://localhost:5000

# Yandex.Metrika counter id (analytics)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Search engine site verification tokens
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
